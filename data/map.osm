<node id="3902165599" version="6" lat="47.2098567" lon="-1.5617613">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2025-07-30"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 2"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Dans les cahiers de doléance de Nantes, en 1789, les négociants nantais demandent le maintien de la traite des Noirs et de protections de l'État en la matière. En février 1794, les députés du commerce de Nantes envoient à la Convention, […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Nantes, ville de l'abolition ?"/>
  <tag k="name:br" v="Naoned, kêr torridigezh ar sklaverezh?"/>
  <tag k="name:en" v="The abolition of the slave trade and slavery in France"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902165600" version="5" lat="47.2098425" lon="-1.5616766">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2025-07-30"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 1"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="En France, au 18e siècle, le mouvement abolitionniste émerge lentement et se heurte à de puissants intérêts commerciaux. L'abolitionnisme en France ne mobilise guère l'opinion publique et reste circonscrit aux milieux des intellectuels. […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Les abolitions de l'esclavage, un combat difficile et inachevé"/>
  <tag k="name:en" v="The abolition of slavery, a difficult and unfinished struggle"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902165601" version="6" lat="47.2101581" lon="-1.5627258">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2025-10-12"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 4"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Conçu par les artistes Krzysztof Wodiczko et Julian Bonder, le Mémorial de l'abolition de l'esclavage est un parcours qui s'offre aux passants dans l'espace public urbain transformé à des fins mémorielles. […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Le Mémorial de l'abolition de l'esclavage"/>
  <tag k="name:br" v="Kounlec'h Torridigezh ar Sklaverezh"/>
  <tag k="name:en" v="The Memorial to the Abolition of Slavery"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902165602" version="4" lat="47.2101789" lon="-1.5627515">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2021-02-20"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 3"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="En 2011, l'ouverture du Mémorial de l'abolition de l'esclavage, conçu par l'artiste Krzysztof Wodiczko et l'architecte Julian Bonder, marque symboliquement une nouvelle étape dans la construction de la connaissance et de la reconnaissance du passé […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Lutter contre l'oubli, mettre en gare pour l'avenir. Une prise de conscience récente"/>
  <tag k="name:en" v="Fighting against forgetfulness, a warning for the future. Recent public awareness"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902235835" version="4" lat="47.2099976" lon="-1.5644214">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2023-02-03"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 5"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="« L'université de Nantes fut fondée en 1460. Mais c'est l'université du commerce qui brille dans cette ville. Ils arment tous les ans plusieurs navires pour la traite des nègres dans les colonies Françaises » Louis de Jaucourt, l'Encyclopédie […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Les bénéficiaires de la traite négrière atlantique. Une famille d'armateurs et négociants : lesMontaudouin."/>
  <tag k="name:en" v="The beneficiaries of the Atlantic slave trade. A ship-owning and merchant family: the Montaudouin"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902235836" version="5" lat="47.2109966" lon="-1.5610648">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2025-03-18"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 6"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Après un combat de deux siècles pour l'abolition de l'esclavage à travers le monde et la prise de conscience progressive des crimes que constituent le commerce d'êtres humains et le travail forcé, on pourrait penser que de telles pratiques n'ont […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="L'esclavage contemporain, un combat d'actualité"/>
  <tag k="name:en" v="Contemporary slavery, the fight goes on"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902235837" version="5" lat="47.2112370" lon="-1.5607272">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2025-03-18"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 7"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Au 18e siècle, Nantes devient le premier port négrier de France, point de départ de plus de 42% es expéditions de traite françaises entre 1707 et 1793. […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Nantes, premier port négrier de France"/>
  <tag k="name:en" v="Nantes, leading slave-trading port in France"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3902235838" version="5" lat="47.2112386" lon="-1.5607288">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2025-03-18"/>
  <tag k="description" v="Parcours thématique « Nantes et la traite négrière » – Étape 7bis"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="La traite négrière atlantique fonctionne selon le schéma du « commerce triangulaire » ou « circuiteux ». Le « triangle » s'effectue ainsi : les navires chargés de marchandises destinées à l'achat des captifs, hommes, femmes, enfants se rendent […]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Le « triangle ». L'Europe négrière."/>
  <tag k="name:en" v="The &quot;triangle&quot;. Slave-trading Europe."/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="information"/>
 </node>
