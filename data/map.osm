  <tag k="tourism" v="information"/>
 </node>
<node id="3913228197" version="3" lat="47.2057941" lon="-1.5665327">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2022-10-11"/>
  <tag k="description" v="Parcours thématique «Le site des Chantiers» - Étape 4"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Amenagée en 1969 à l'emplacement de deux anciennes cales des Ateliers et Chantiers de Bretagne, elle fut couverte d'une charpente métallique. À l'abri des regards indiscrets on y contruisait, entre autres, des sous-marins. Le 3 octobre 1986, y fut [...]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="La cale couverte"/>
  <tag k="name:de" v="die überdachte Slipanlage"/>
  <tag k="name:en" v="The covered hold"/>
  <tag k="name:es" v="La cala cubierta"/>
  <tag k="name:it" v="Lo scalo coperto"/>
