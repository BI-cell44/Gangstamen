<node id="3912554223" version="6" lat="47.2066028" lon="-1.5664304">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2022-08-30"/>
  <tag k="description" v="Parcours thématique «Le site des Chantiers» - Étape 2"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="La cale, mise au jour et valorisée en 2009 dans le cadre de l'aménagement du Jardin des voyage faisait partie des Ateliers et Chantiers de bretane (ACB). Les ACB sont nés de la volonté de deux hommes: Eugène de la Brosse, sorti de l'École des Mines, [...]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="La Cale des Ateliers et Chantiers de Bretagne"/>
  <tag k="name:br" v="Kal Atalieroù ha Chanterioù Breizh"/>
  <tag k="name:de" v="Die Slipanlage der Ateliers et Chantiers de Bretagne (Werkstätten und Werften)"/>
  <tag k="name:en" v="The Ateliers et Chantiers de Bretagne hold"/>
  <tag k="name:es" v="La cala de los Ateliers et Chantiers de Bretagne"/>
  <tag k="name:it" v="Lo scalo degli Ateliers et Chantiers de Bretagne"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="subject:wikidata" v="Q2868911"/>
  <tag k="subject:wikipedia" v="fr:Ateliers et chantiers de Bretagne"/>
  <tag k="support" v="pedestal"/>
  <tag k="tactile_writing:braille:lg" v="yes"/>
  <tag k="tourism" v="information"/>
 </node>
<node id="3912554224" version="6" lat="47.2059611" lon="-1.5657871">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2022-10-11"/>
  <tag k="description" v="Parcours thématique «Le site des Chantiers» - Étape 3"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Ce bâtiment en béton armé, construit entre 1914 et 1917, fut principalement le siège de l'administration des Ateliers et Chantiers de la Loire (ACL), puis celui des Ateliers et Chantiers de Nantes (ACN) de 1961 à 1969. À l'origine, y étaient [...]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="Les Ateliers &amp; Chantiers de Nantes"/>
  <tag k="name:de" v="Die Ateliers et Chantiers de Nantes"/>
  <tag k="name:en" v="The Ateliers et Chantiers de Nantes"/>
  <tag k="name:es" v="Los Ateliers et Chantiers de Nantes"/>
  <tag k="name:it" v="Gli Ateliers et Chantiers de Nantes"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="portrait"/>
  <tag k="subject:wikidata" v="Q2868920"/>
