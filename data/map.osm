  <node id="3389475043" lat="47.2055546" lon="-1.5745571">
    <tag k="description" v="plaque commémorative"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="LE 15 SEPTEMBRE 1858 LE 3 MATS MAURICE DE LA MAISON LA BOTERF ET GRESLÉ DE NANTES SAUVE 67 NAUFRAGÉS DU STEAMER ALLEMAND AUSTRIA INCENDIÉ EN MER. ÉQUIPAGE DU MAURICE. RENAUD PHILIPPE ACHARD ERNEST. CAPITAINE. (...)"/>
    <tag k="material" v="bronze"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="hommage aux naufragés du steamer Austria"/>
    <tag k="wikimedia_commons" v="File:Plaque commémorative 18 quai Ernest Renaud Nantes.jpg"/>
  </node>
  <node id="3389489658" lat="47.2104751" lon="-1.5706709">
    <tag k="description" v="Plaque commémorative en hommage aux victimes de la Terreur"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="ANCIEN ENTREPOT DES CAFES PENDANT LA TERREUR, DURANT L’HIVER 1793 - 1794, LORS DE LA MISSION DE J.B. CARRIER (...) 8 À 9.000 “VENDÉENS”, D’ANJOU, DU PAYS NANTAIS, DU POITOU, HOMMES, FEMMES, ENFANTS FURENT ENTASSÉS À L’ENTREPÔT. PRESQUE TOUS PÉRIRENT.(...)"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Aux victimes de la Terreur (1793-94)"/>
    <tag k="name:br" v="Da reuzidi ar Spont Bras (1793-94)"/>
    <tag k="wikimedia_commons" v="File:Plaque commémorative entrepôt cafés 2 rue Lamoricière Nantes.jpg"/>
  </node>
