<node id="3913228203" version="3" lat="47.2056565" lon="-1.5668548">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2022-10-11"/>
  <tag k="description" v="Parcours thématique «Le site des Chantiers» - Étape 6"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="À partir de la fin des années 1950 avec le développement de la préfabrication, de nouveaux outils de travail apparaissent sur les chantiers. À l'emplacement actuel de la cité des Chantiers, face à vous, se trouvait l'atelier de préfabrication n°3 [...]"/>
  <tag k="material" v="enameled_lava"/>
  <tag k="name" v="l'AP3 et la Grue Titan, de nouveaux outils de travail à l'ère de la préfabrication"/>
  <tag k="name:de" v="Der AP3 und der Kran Titan - neue Werkzeuge zu Zeïten der Vorfabrikation"/>
  <tag k="name:en" v="The AP3 and the Titan crane, new work tools and the era of prefabrication"/>
  <tag k="name:es" v="El AP3 y la grua Titan, nuevas herramientas de trabadjo de la era de la prefabricacion"/>
  <tag k="name:it" v="L'AP3 e la gru Titan, nuovi strumenti di lavoro nell'era delle strotture prefabbricate"/>
  <tag k="operator" v="Ville de Nantes"/>
  <tag k="orientation" v="landscape"/>
  <tag k="support" v="wall_mounted"/>
  <tag k="tactile_writing:braille:lg" v="yes"/>
  <tag k="tourism" v="information"/>
 </node>
